        "    for k, d in enumerate(app.digits):\n",
        "        S = app.B[app.y == d][:per_digit]\n",
        "        for s in S:\n",
        "            x0 = flip_noise(s, noise, rng_global) if noise > 0 else s\n",
        "            out, _, _ = net.recall(x0, rng=rng_global)\n",
        "            kind, kk, ov, ham = net.classify(out)\n",
        "            cm[k, kk if kind == \"stored\" else D] += 1\n",
        "    return cm\n",
